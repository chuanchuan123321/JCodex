# 麒麟OS-Agent 配置文件

# AI API 配置
API_BASE_URL=https://yunwu.ai
API_KEY=your_api_key_here
API_MODEL=claude-haiku-4-5-20251001

# 模型参数
MAX_TOKENS=30000
TEMPERATURE=0.7

# 执行配置
MAX_STEPS=20
COMPRESS_AT=25000
MAX_WEB_SEARCHES=3
SHOW_KNOWLEDGE_APPENDIX=true

# 搜索 API 配置
TAVILY_API_KEY=your_tavily_api_key_here

# 知识库向量化配置（可选）
# auto: 优先调用银河麒麟系统 Embedding SDK，失败时使用本地 hash fallback
# hash: 强制使用本地 hash fallback，适合非银河麒麟开发机
MINIBOT_EMBEDDING_PROVIDER=auto
KYLIN_EMBEDDING_LIBRARY=
KYLIN_EMBEDDING_MODEL=

# 飞书配置（可选）
FEISHU_ENABLED=false
FEISHU_APP_ID=your_feishu_app_id
FEISHU_APP_SECRET=your_feishu_app_secret
