# 麒麟OS-Agent 配置文件

# AI API 配置
API_BASE_URL=https://api.deepseek.com
API_KEY=your_api_key_here
API_MODEL=deepseek-v4-pro
# 多模态视觉开关：false 时从模型工具中移除 view_image（该工具仅支持多模态模型，默认 true）
MODEL_SUPPORTS_VISION=true

# 模型参数
MAX_TOKENS=50000
CONTEXT_WINDOW=256000
AUTO_COMPACT_THRESHOLD_PERCENT=85
MINIBOT_DESKTOP_PORT=8000
COMPACTION_MAX_ATTEMPTS=3
# Compression uses a dedicated request budget. Normal model calls still use
# their existing MAX_TOKENS setting.
COMPACTION_TIMEOUT_SECONDS=300
MEMORY_FLUSH_TIMEOUT_SECONDS=180
TEMPERATURE=0.7

# 执行配置
MAX_STEPS=100
# 相同工具/命令重复调用多少次后触发防循环拦截（默认 3，即第 3 次相同调用被拦截；
# 设为 8 则允许复用 6 次，第 8 次相同调用才拦截）
MAX_SAME_TOOL_REPEATS=3
MAX_WEB_SEARCHES=8

# 搜索 API 配置
TAVILY_API_KEY=your_tavily_api_key_here

# Grok 风格长期记忆检索（Embedding 模型留空时使用 FTS5/BM25）
MEMORY_EMBEDDING_MODEL=
# 维度可选，留空时使用向量模型自身的默认维度
MEMORY_EMBEDDING_DIMENSIONS=1024
# 需单独配置，不再回退复用 API_BASE_URL / API_KEY
MEMORY_EMBEDDING_BASE_URL=
MEMORY_EMBEDDING_API_KEY=
MEMORY_MIN_SCORE=0.35
MEMORY_VECTOR_WEIGHT=0.7
MEMORY_TEXT_WEIGHT=0.3
MEMORY_HALF_LIFE_DAYS=7
MEMORY_MMR_ENABLED=false
MEMORY_MMR_LAMBDA=0.7

# 飞书配置（可选）
FEISHU_ENABLED=false
FEISHU_APP_ID=your_feishu_app_id
FEISHU_APP_SECRET=your_feishu_app_secret
